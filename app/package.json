{
  "name": "zzmq",
  "version": "1.0.0",
  "description": "zz: an agentic OSS coordination layer -- CLI for creating, working, and reviewing repos against a zz coordination server.",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzmq-dev/zz.git",
    "directory": "app"
  },
  "homepage": "https://github.com/zzmq-dev/zz#readme",
  "bugs": {
    "url": "https://github.com/zzmq-dev/zz/issues"
  },
  "type": "module",
  "bin": {
    "zz": "dist/cli/zz.js"
  },
  "files": [
    "dist/**/*.js"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/zz.js",
    "prepublishOnly": "npm run build",
    "setup:demo-repos": "tsx demo-repos/setup.ts",
    "build-ladder": "tsx demo/ladder-full-supertest.ts",
    "dump-ladder": "tsx demo/dump-ladder.ts",
    "zz": "tsx cli/zz.ts",
    "demo:new-feature": "tsx demo/run-new-feature.ts",
    "demo:case-study": "tsx demo/run-cascade-case-study.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "isomorphic-git": "^1.43.1",
    "react": "^19.3.0"
  }
}
