{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": ["engine/**/*.ts", "demo/**/*.ts", "demo-repos/**/*.ts"],
  "exclude": ["node_modules", "demo-repos/superagent", "demo-repos/supertest"]
}
