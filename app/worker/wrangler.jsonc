{
  "name": "zz-maintainer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "zz"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MAINTAINER_DO",
        "class_name": "MaintainerDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MaintainerDO"]
    }
  ]
}
