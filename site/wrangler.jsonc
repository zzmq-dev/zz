{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zzbin-docs",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./builds/current"
  },
  "routes": [
    // zzbin.dev stays live (not torn down as part of this migration --
    // that's a separate decision). The new split: zzmq.dev's bare root
    // serves this same landing page (an exact-path route, not a
    // custom_domain -- custom_domain claims a whole hostname
    // exclusively, but zzmq.dev/* elsewhere belongs to the zz-maintainer
    // worker, so this has to be a classic route scoped to just "/"),
    // and the rest of the docs site moves to docs.zzmq.dev.
    { "pattern": "zzbin.dev", "custom_domain": true },
    { "pattern": "zzmq.dev/", "zone_name": "zzmq.dev" },
    { "pattern": "docs.zzmq.dev", "custom_domain": true }
  ]
}
